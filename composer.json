{
	"name": "hehex/hehep-hevent",
	"description": "hehep-hevent 是一个PHP 用户事件组件,基本概念:事件,事件监听器,事件注解,事件管理器",
	"license": "Apache-2.0",
	"authors": [
		{
			"name": "hehe"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^8.5"
	},
	"autoload": {
		"psr-4": {
			"hehe\\core\\hevent\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"hevent\\test\\": "tests/"
		}
	},
	"scripts": {
		"test:win": ["@test:php7","@test:php8"],
		"test:php7": "D:/bin/phpstudy_pro/Extensions/php/php7.4.3nts/php.exe ../vendor/bin/phpunit",
		"test:php8": "D:/bin/phpstudy_pro/Extensions/php/php8.2.9nts/php.exe ../vendor/bin/phpunit"
	}
}
